generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transcription {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  status       String
  text         String?  @db.Text
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
