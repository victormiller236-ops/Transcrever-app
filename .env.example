# Banco (Postgres). Na Vercel vem da integração Neon.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Login do app (uma pessoa só)
APP_PASSWORD=
AUTH_SECRET=            # openssl rand -base64 32

# IA (áudio → tarefas e transcrição)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=       # só para proxy/teste

# Arquivos grandes da aba Transcrever
BLOB_READ_WRITE_TOKEN=

# Avisos no celular (npm run vapid gera estas linhas)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
CRON_SECRET=

# Fuso padrão quando o navegador não informa o dele
# APP_TIMEZONE=America/Sao_Paulo
