{
  "name": "transcrever-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "vitest run tests/unit",
    "test:e2e": "next build && vitest run tests/integration tests/e2e",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "icons": "node scripts/gen-icons.mjs",
    "vapid": "node scripts/gen-vapid.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
